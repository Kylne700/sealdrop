# Copy to .env.local, or run `npm run keys` to fill it with fresh testnet-only keys.
# Only VITE_* variables are compiled into the browser bundle.

# Shared "demo mode" sender: testnet GLM only, public by design.
VITE_DEMO_SENDER_PRIVATE_KEY=

# Optional: point the Demo Desk link at your own desk newsroom (defaults to the published one).
# VITE_DEMO_DESK_ADDRESS=0x...

# Scripts only, never shipped:
FUNDER_PRIVATE_KEY=
DEMO_DESK_PRIVATE_KEY=
DEMO_DESK_BOX_SECRET=
