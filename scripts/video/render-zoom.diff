+def zoom_keys(zooms, nv, W, H, fr):
+    """Zoom windows -> Motion keyframes [(frame in segment, scale %, position [x, y], interpolation)]. 100 % at t0, `scale` after `ramp`, 100 % again at t1.
+    The window is clamped to the frame (no black border). Motion's anchor stays at the source centre, so position = where that centre lands.
+    easeOut on a ramp's first key + easeIn on its last = smoothstep on scale AND position (same curve, so the focus point stays exact)."""
+    keys, end = [], -1
+    for z in zooms:
+        s, r = z["scale"], z.get("ramp", 0.5)
+        a, b, c, d = fr(z["t0"]), fr(z["t0"] + r), fr(z["t1"] - r), fr(z["t1"])
+        if not (s > 1 and end < a < b < c < d <= nv):  # strict: every keyframe has one ease role
+            die(f"zoom {z}: needs scale > 1, ramp >= 1 frame, 2 * ramp < t1 - t0, windows in order with a gap, all inside the video ({nv} frames)")
+        end = d
+        ox = min(max(z.get("cx", 0.5) * W - W / (2 * s), 0), W - W / s)  # window origin in the source, kept inside the frame
+        oy = min(max(z.get("cy", 0.5) * H - H / (2 * s), 0), H - H / s)
+        ctr, zin = (100, [W / 2, H / 2]), (100 * s, [s * (W / 2 - ox), s * (H / 2 - oy)])
+        keys += [(a, *ctr, "easeOut"), (b, *zin, "easeIn"), (c, *zin, "easeOut"), (d, *ctr, "easeIn")]
+    return keys
+
