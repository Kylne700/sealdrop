{
  "name": "sealdrop",
  "version": "0.1.0",
  "description": "Anonymous, self-expiring encrypted tip line on Arkiv. SecureDrop without a server.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "keys": "node scripts/gen-keys.mjs",
    "ops": "tsx scripts/ops.ts",
    "integration": "tsx scripts/integration.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@arkiv-network/sdk": "^0.8.1",
    "tweetnacl": "^1.0.3",
    "viem": "^2.57.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "puppeteer-core": "^25.14.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
